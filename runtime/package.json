{
  "name": "@minecraft-ai-npc/runtime",
  "version": "0.1.0",
  "description": "Agent-Runtime fuer autonome Minecraft-NPCs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "mineflayer": "^4.39.0",
    "pino": "^10.4.0",
    "rcon-client": "^4.2.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
